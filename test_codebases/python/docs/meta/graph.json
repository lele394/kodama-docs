   "vararg": false,
   "file_id": "file:render.py",
   "body": "    def draw_body(self, body):\n        ix = int((body.x / 20.0 + 1.0) * (WIDTH - 1) / 2.0)\n        iy = int((body.y / 20.0 + 1.0) * (HEIGHT - 1) / 2.0)\n        mark = PALETTE[int(abs(body.mass) % len(PALETTE))]\n        return (min(max(ix, 0), WIDTH - 1),\n                min(max(iy, 0), HEIGHT - 1), mark)",
   "id": "fn:render.py::draw_body@13"
  },
  {
   "kind": "function",
   "relpath": "render.py",
   "name": "draw_all",
   "qualified": "draw_all",
   "line": 21,
   "end_line": 26,
   "params": [
