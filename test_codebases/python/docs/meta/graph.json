  {
   "kind": "function",
   "relpath": "nbody.py",
   "name": "accelerations",
   "qualified": "accelerations",
   "line": 22,
   "end_line": 47,
   "params": [
    "self",
    "bodies"
   ],
   "vararg": false,
   "file_id": "file:nbody.py",
   "body": "    def accelerations(self, bodies):\n        for b in bodies:\n            b.ax = b.ay = b.az = 0.0\n\n        n = len(bodies)\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                bi, bj = bodies[i], bodies[j]\n                dx = bj.x - bi.x\n                dy = bj.y - bi.y\n                dz = bj.z - bi.z\n                d2 = dx * dx + dy * dy + dz * dz\n                if d2 < MIN_DIST:\n                    d2 = MIN_DIST\n                dist = math.sqrt(d2)\n                inv3 = 1.0 / (dist * d2)\n                fi = G * bj.mass * inv3\n                fj = G * bi.mass * inv3\n                bi.ax += fi * dx\n                bi.ay += fi * dy\n                bi.az += fi * dz\n                bj.ax -= fj * dx\n                bj.ay -= fj * dy\n                bj.az -= fj * dz\n\n        return bodies",
   "id": "fn:nbody.py::accelerations@22"
  },
  {
   "kind": "function",
   "relpath": "nbody.py",
   "name": "step",
   "qualified": "step",
   "line": 50,
   "end_line": 59,
   "params": [
    "self",
    "bodies",
    "dt"
   ],
   "vararg": false,
   "file_id": "file:nbody.py",
   "body": "    def step(self, bodies, dt):\n        for b in bodies:\n            b.vx += b.ax * dt\n            b.vy += b.ay * dt\n            b.vz += b.az * dt\n\n        for b in bodies:\n            b.x += b.vx * dt\n            b.y += b.vy * dt\n            b.z += b.vz * dt",
   "id": "fn:nbody.py::step@50"
  },
  {
   "kind": "function",
   "relpath": "nbody.py",
   "name": "total_energy",
   "qualified": "total_energy",
   "line": 62,
   "end_line": 72,
   "params": [
    "self",
    "bodies"
   ],
   "vararg": false,
   "file_id": "file:nbody.py",
   "body": "    def total_energy(self, bodies):\n        e = sum(b.kinetic_energy() for b in bodies)\n\n        n = len(bodies)\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                bi, bj = bodies[i], bodies[j]\n                d = Vec3(bj.x - bi.x, bj.y - bi.y, bj.z - bi.z).length()\n                e -= G * bi.mass * bj.mass / d\n\n        return e",
   "id": "fn:nbody.py::total_energy@62"
  },
