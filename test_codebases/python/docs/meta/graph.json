   ],
   "vararg": false,
   "file_id": "file:main.py",
   "body": "def tick(sim, bodies, renderer, dt):\n    e = sim.total_energy(bodies)\n    sim.accelerations(bodies)\n    sim.step(bodies, dt)\n    frame = renderer.draw_all(bodies)\n    return e, \"\\n\".join(frame), renderer.stats_line(len(bodies), e)",
   "id": "fn:main.py::tick@43"
  },
  {
   "kind": "function",
   "relpath": "main.py",
   "name": "main",
   "qualified": "main",
   "line": 51,
   "end_line": 63,
   "params": [],
   "vararg": false,
   "file_id": "file:main.py",
   "body": "def main():\n    sim = NBody()\n    renderer = Renderer()\n    if MODE == \"circular\":\n        bodies = make_circular_system(8)\n    else:\n        bodies = make_random_system(12, os.time())\n\n    dt = 1 / FPS\n    for _ in range(RUNS):\n        tick(sim, bodies, renderer, dt)\n\n    return len(bodies)",
   "id": "fn:main.py::main@51"
  },
