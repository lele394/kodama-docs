    "bodies"
   ],
   "vararg": false,
   "file_id": "file:render.py",
   "body": "    def draw_all(self, bodies):\n        grid = [[\" \"] * WIDTH for _ in range(HEIGHT)]\n        for body in bodies:\n            ix, iy, mark = self.draw_body(body)\n            grid[iy][ix] = mark\n        return [\"\".join(row) for row in grid]",
   "id": "fn:render.py::draw_all@21"
  },
