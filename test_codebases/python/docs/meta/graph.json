  {
   "kind": "function",
   "relpath": "main.py",
   "name": "make_circular_system",
   "qualified": "make_circular_system",
   "line": 16,
   "end_line": 25,
   "params": [
    "n"
   ],
   "vararg": false,
   "file_id": "file:main.py",
   "body": "def make_circular_system(n):\n    bodies = [Body(0, 0, 0, 0, 0, 0, 1000)]\n    for i in range(1, n + 1):\n        r = 10 + i * 2\n        v = (1000 / r) ** 0.5\n        a = 2 * math.pi * i / n\n        bodies.append(Body(\n            math.cos(a) * r, math.sin(a) * r, 0,\n            -math.sin(a) * v, math.cos(a) * v, 0, 1))\n    return bodies",
   "id": "fn:main.py::make_circular_system@16"
  },
  {
   "kind": "function",
   "relpath": "main.py",
   "name": "make_random_system",
   "qualified": "make_random_system",
   "line": 29,
   "end_line": 39,
   "params": [
    "n",
    "seed"
   ],
   "vararg": false,
   "file_id": "file:main.py",
   "body": "def make_random_system(n, seed):\n    import random\n    random.seed(seed)\n    bodies = []\n    for _ in range(n):\n        bodies.append(Body(\n            random.uniform(-10, 10), random.uniform(-10, 10),\n            random.uniform(-10, 10),\n            random.uniform(-0.1, 0.1), random.uniform(-0.1, 0.1), 0,\n            1 + random.random()))\n    return bodies",
   "id": "fn:main.py::make_random_system@29"
  },
  {
   "kind": "function",
   "relpath": "main.py",
   "name": "tick",
   "qualified": "tick",
   "line": 43,
   "end_line": 48,
   "params": [
    "sim",
