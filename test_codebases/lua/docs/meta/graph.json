  {
   "kind": "function",
   "relpath": "physics/nbody.lua",
   "name": "accelerations",
   "qualified": "NBody.accelerations",
   "line": 18,
   "end_line": 49,
   "params": [
    "self",
    "bodies"
   ],
   "vararg": false,
   "file_id": "file:physics/nbody.lua",
   "body": "function NBody:accelerations(bodies)\n  local n = #bodies\n  for i = 1, n do\n    bodies[i].ax = 0\n    bodies[i].ay = 0\n    bodies[i].az = 0\n  end\n\n  for i = 1, n - 1 do\n    for j = i + 1, n do\n      local dx = bodies[j].x - bodies[i].x\n      local dy = bodies[j].y - bodies[i].y\n      local dz = bodies[j].z - bodies[i].z\n      local d2 = dx * dx + dy * dy + dz * dz\n      if d2 < MIN_DIST then\n        d2 = MIN_DIST\n      end\n      local dist = math.sqrt(d2)\n      local inv3 = 1.0 / (dist * d2)\n      local fi = G * bodies[j].mass * inv3\n      local fj = G * bodies[i].mass * inv3\n      bodies[i].ax = bodies[i].ax + fi * dx\n      bodies[i].ay = bodies[i].ay + fi * dy\n      bodies[i].az = bodies[i].az + fi * dz\n      bodies[j].ax = bodies[j].ax - fj * dx\n      bodies[j].ay = bodies[j].ay - fj * dy\n      bodies[j].az = bodies[j].az - fj * dz\n    end\n  end\n\n  return bodies\nend",
   "id": "fn:physics/nbody.lua::accelerations@18"
  },
  {
   "kind": "function",
   "relpath": "physics/nbody.lua",
   "name": "step",
   "qualified": "NBody.step",
   "line": 52,
   "end_line": 66,
   "params": [
    "self",
    "bodies",
    "dt"
   ],
   "vararg": false,
   "file_id": "file:physics/nbody.lua",
   "body": "function NBody:step(bodies, dt)\n  for i = 1, #bodies do\n    local b = bodies[i]\n    b.vx = b.vx + b.ax * dt\n    b.vy = b.vy + b.ay * dt\n    b.vz = b.vz + b.az * dt\n  end\n\n  for i = 1, #bodies do\n    local b = bodies[i]\n    b.x = b.x + b.vx * dt\n    b.y = b.y + b.vy * dt\n    b.z = b.z + b.vz * dt\n  end\nend",
   "id": "fn:physics/nbody.lua::step@52"
  },
  {
   "kind": "function",
   "relpath": "physics/nbody.lua",
   "name": "total_energy",
   "qualified": "NBody.total_energy",
   "line": 69,
   "end_line": 85,
   "params": [
    "self",
    "bodies"
   ],
   "vararg": false,
   "file_id": "file:physics/nbody.lua",
   "body": "function NBody:total_energy(bodies)\n  local e = 0\n  for i = 1, #bodies do\n    e = e + bodies[i]:kinetic_energy()\n  end\n\n  for i = 1, #bodies - 1 do\n    for j = i + 1, #bodies do\n      local d = vec3.length(vec3.sub(\n        { bodies[j].x, bodies[j].y, bodies[j].z },\n        { bodies[i].x, bodies[i].y, bodies[i].z }))\n      e = e - G * bodies[i].mass * bodies[j].mass / d\n    end\n  end\n\n  return e\nend",
   "id": "fn:physics/nbody.lua::total_energy@69"
  },
