   ],
   "vararg": false,
   "file_id": "file:physics/body.lua",
   "body": "function Body:apply_force(fx, fy, fz, dt)\n  self.vx = self.vx + fx * dt / self.mass\n  self.vy = self.vy + fy * dt / self.mass\n  self.vz = self.vz + fz * dt / self.mass\nend",
   "id": "fn:physics/body.lua::apply_force@26"
  },
  {
   "kind": "function",
   "relpath": "physics/body.lua",
   "name": "kinetic_energy",
   "qualified": "Body.kinetic_energy",
   "line": 33,
   "end_line": 37,
   "params": [
    "self"
   ],
   "vararg": false,
   "file_id": "file:physics/body.lua",
   "body": "function Body:kinetic_energy()\n  return 0.5 * self.mass * (self.vx * self.vx\n                            + self.vy * self.vy\n                            + self.vz * self.vz)\nend",
   "id": "fn:physics/body.lua::kinetic_energy@33"
  },
