  {
   "kind": "function",
   "relpath": "physics/body.lua",
   "name": "apply_force",
   "qualified": "Body.apply_force",
   "line": 26,
   "end_line": 30,
   "params": [
    "self",
    "fx",
    "fy",
    "fz",
