   "vararg": false,
   "file_id": "file:physics/body.lua",
   "body": "function Body:reset(x, y, z, vx, vy, vz)\n  self.x, self.y, self.z = x, y, z\n  self.vx, self.vy, self.vz = vx, vy, vz\n  self.ax, self.ay, self.az = 0, 0, 0\nend",
   "id": "fn:physics/body.lua::reset@19"
