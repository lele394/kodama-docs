   "vararg": false,
   "file_id": "file:physics/body.lua",
   "body": "function Body:new(x, y, z, vx, vy, vz, mass)\n  local self = setmetatable({}, { __index = Body })\n  self.x, self.y, self.z = x, y, z\n  self.vx, self.vy, self.vz = vx, vy, vz\n  self.mass = mass\n  self.ax, self.ay, self.az = 0, 0, 0\n  return self\nend",
   "id": "fn:physics/body.lua::new@9"
  },
