   "vararg": false,
   "file_id": "file:vec3.lua",
   "body": "function V.dot(a, b)\n  return a[1] * b[1] + a[2] * b[2] + a[3] * b[3]\nend",
   "id": "fn:vec3.lua::dot@25"
  },
  {
   "kind": "function",
   "relpath": "vec3.lua",
   "name": "length",
   "qualified": "V.length",
   "line": 30,
   "end_line": 36,
   "params": [
    "v"
   ],
   "vararg": false,
   "file_id": "file:vec3.lua",
   "body": "function V.length(v)\n  local d = math.sqrt(V.dot(v, v))\n  if d < EPS then\n    return EPS\n  end\n  return d\nend",
   "id": "fn:vec3.lua::length@30"
  },
  {
   "kind": "function",
   "relpath": "vec3.lua",
   "name": "normalize",
   "qualified": "V.normalize",
   "line": 42,
   "end_line": 48,
   "params": [
    "v"
   ],
   "vararg": false,
   "file_id": "file:vec3.lua",
   "body": "function V.normalize(v)\n  local d = V.length(v)\n  if d <= EPS then\n    return ZERO\n  end\n  return V.scale(v, 1 / d)\nend",
   "id": "fn:vec3.lua::normalize@42"
