  {
   "kind": "function",
   "relpath": "main.lua",
   "name": "make_circular_system",
   "qualified": "make_circular_system",
   "line": 12,
   "end_line": 23,
   "params": [
    "n"
   ],
   "vararg": false,
   "file_id": "file:main.lua",
   "body": "local function make_circular_system(n)\n  local bodies = { Body:new(0, 0, 0, 0, 0, 0, 1000) }\n  for i = 1, n do\n    local r = 10 + i * 2\n    local v = math.sqrt(1000 / r)\n    local a = 2 * math.pi * i / n\n    table.insert(bodies, Body:new(\n      math.cos(a) * r, math.sin(a) * r, 0,\n      -math.sin(a) * v, math.cos(a) * v, 0, 1))\n  end\n  return bodies\nend",
   "id": "fn:main.lua::make_circular_system@12"
  },
  {
   "kind": "function",
   "relpath": "main.lua",
   "name": "make_random_system",
   "qualified": "make_random_system",
   "line": 26,
   "end_line": 36,
   "params": [
    "n",
    "seed"
   ],
   "vararg": false,
   "file_id": "file:main.lua",
   "body": "local function make_random_system(n, seed)\n  math.randomseed(seed)\n  local bodies = {}\n  for i = 1, n do\n    table.insert(bodies, Body:new(\n      math.random() * 20 - 10, math.random() * 20 - 10, math.random() * 20 - 10,\n      math.random() * 0.2 - 0.1, math.random() * 0.2 - 0.1, 0,\n      1 + math.random()))\n  end\n  return bodies\nend",
   "id": "fn:main.lua::make_random_system@26"
  },
  {
   "kind": "function",
   "relpath": "main.lua",
   "name": "tick",
   "qualified": "tick",
   "line": 39,
   "end_line": 44,
   "params": [
    "sim",
    "bodies",
    "dt"
   ],
   "vararg": false,
   "file_id": "file:main.lua",
   "body": "local function tick(sim, bodies, dt)\n  local e = sim:total_energy(bodies)\n  sim:accelerations(bodies)\n  sim:step(bodies, dt)\n  log.info(\"energy=\" .. tostring(e))\nend",
   "id": "fn:main.lua::tick@39"
  },
  {
   "kind": "function",
   "relpath": "main.lua",
   "name": "main",
   "qualified": "main",
   "line": 46,
   "end_line": 60,
   "params": [],
   "vararg": false,
   "file_id": "file:main.lua",
   "body": "local function main()\n  local bodies\n  if MODE == \"circular\" then\n    bodies = make_circular_system(8)\n  else\n    bodies = make_random_system(12, os.time())\n  end\n\n  local dt = 1 / FPS\n  for _ = 1, RUNS do\n    tick(NBody, bodies, dt)\n  end\n\n  return #bodies\nend",
   "id": "fn:main.lua::main@46"
  },
