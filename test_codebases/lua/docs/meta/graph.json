   "vararg": false,
   "file_id": "file:physics/vec3.lua",
   "body": "function V.normalize(v)\n  local d = V.length(v)\n  if d <= EPS then\n    return ZERO\n  end\n  return V.scale(v, 1 / d)\nend",
